{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud WAN Policy Visualizer",
  "version": "0.1.0",
  "identifier": "com.example.cloudwan-policy-viz",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cloud WAN Policy Visualizer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved."
  }
}
